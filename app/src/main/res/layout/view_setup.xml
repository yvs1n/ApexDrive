<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Card 1: Cockpit Appearance & Integration Settings -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COCKPIT ACCENT COLOR"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Accent Color Swatch Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnColorAmber"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/accent_amber" />

            <Button
                android:id="@+id/btnColorBlue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@color/accent_hyundai_blue" />

            <Button
                android:id="@+id/btnColorRed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@color/accent_sport_red" />

            <Button
                android:id="@+id/btnColorGreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@color/accent_emerald" />

            <Button
                android:id="@+id/btnColorWhite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@color/accent_platinum" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- CarPlay / Phone Launcher Selection (Requested!) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CarPlay App"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSelectCarPlayApp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="Zlink 5.3"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speedometer Unit"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnToggleUnit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="KM/H"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Display Lighting"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnToggleTheme"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="Night OLED Mode"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Space -->
    <View
        android:layout_width="12dp"
        android:layout_height="match_parent" />

    <!-- Card 2: Santa Fe & Hardware Telemetry -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SANTA FE IX45 HARDWARE INTEGRATION"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Platform: Allwinner T3L (ARMv7-a 4-Core)"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Memory: 2.0 GB RAM (776 MB Active)"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CAN Decoder: 03: Simple Soft (XP)"
            android:textColor="@color/status_active"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vehicle Profile: 61: Hyundai Kia / Santa Fe"
            android:textColor="@color/status_active"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Audio Tuner IC: Rohm37XXX / SI473X"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Factory PINs: 123456 / 7890"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOpenAndroidSettings"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="Open Head Unit Settings"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
