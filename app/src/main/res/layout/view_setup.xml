<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Card 1: Cockpit Appearance & Vehicle Units -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWISS COCKPIT ACCENT COLOR"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Accent Color Swatch Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnColorAmber"
                android:layout_width="50dp"
                android:layout_height="46dp"
                android:background="@color/accent_amber" />

            <Button
                android:id="@+id/btnColorBlue"
                android:layout_width="50dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@color/accent_hyundai_blue" />

            <Button
                android:id="@+id/btnColorRed"
                android:layout_width="50dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@color/accent_sport_red" />

            <Button
                android:id="@+id/btnColorGreen"
                android:layout_width="50dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@color/accent_emerald" />

            <Button
                android:id="@+id/btnColorWhite"
                android:layout_width="50dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@color/accent_platinum" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- CarPlay / Phone Launcher Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CarPlay App"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnSelectCarPlayApp"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="Zlink 5.3"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speedometer Unit"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnToggleUnit"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="KM/H"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GPS Refresh Rate"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnGpsRefreshRate"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="LIVE 20Hz"
                android:textColor="@color/status_active"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Space -->
    <View
        android:layout_width="10dp"
        android:layout_height="match_parent" />

    <!-- Card 2: Essential Automotive Shortcuts & Diagnostics (Requested!) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTOMOTIVE SHORTCUTS &amp; DIAGNOSTICS"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- 01. Driver Phone Switcher (CarPlay & Bluetooth Gateway) -->
        <Button
            android:id="@+id/btnSelectDriverPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="01 · SELECT DRIVER PHONE"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="center" />

        <!-- 02. Factory Settings (Pin 123456 / 7890 reminder) -->
        <Button
            android:id="@+id/btnShortcutFactorySettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="02 · FACTORY SETTINGS (PIN 123456)"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="center" />

        <!-- 03. Android System Settings (Wi-Fi, Brightness, Sound) -->
        <Button
            android:id="@+id/btnShortcutAndroidSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="03 · SYSTEM SETTINGS (WIFI &amp; SOUND)"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="center" />

        <!-- 04. DSP Equalizer / Car Audio IC -->
        <Button
            android:id="@+id/btnShortcutAudioEq"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="04 · DSP EQUALIZER TUNER"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="center" />

        <!-- 05. Bluetooth Connection Manager -->
        <Button
            android:id="@+id/btnShortcutBluetooth"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="05 · BLUETOOTH MANAGER"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="center" />

        <!-- 06. Soft Reload Launcher -->
        <Button
            android:id="@+id/btnRestartLauncher"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="06 · RESTART APEXDRIVE"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
