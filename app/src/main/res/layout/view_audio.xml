<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Source Selector Rail -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="10dp">

        <Button
            android:id="@+id/btnSrcRadio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="01  FM RADIO TUNER"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/btnSrcSpotify"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="02  SPOTIFY AUDIO"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/btnSrcBluetooth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="03  BLUETOOTH STREAM"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/btnSrcUsb"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="04  USB MEDIA"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

    </LinearLayout>

    <View
        android:layout_width="12dp"
        android:layout_height="match_parent" />

    <!-- Radio / Audio Tuner Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAudioActiveSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FM RADIO TUNER (SI473X IC)"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAudioPresetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRESET 01"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRadioFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98.5"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="88sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvRadioFreqUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MHZ · STEREO BROADCAST"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRadioScanDown"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="SEEK DOWN"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />

            <Button
                android:id="@+id/btnRadioScanUp"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="SEEK UP"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
