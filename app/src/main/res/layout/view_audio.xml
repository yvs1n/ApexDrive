<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Source Selector Rail -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="10dp">

        <Button
            android:id="@+id/btnSrcRadio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="01  FM radio tuner"
            android:textColor="@color/ad_accent_text"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btnSrcSpotify"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="02  Spotify audio"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btnSrcBluetooth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="03  Bluetooth stream"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp" />

        <Button
            android:id="@+id/btnSrcUsb"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="04  USB media"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp" />

    </LinearLayout>

    <View
        android:layout_width="12dp"
        android:layout_height="match_parent" />

    <!-- Radio / Audio Tuner Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAudioActiveSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fm radio tuner (si473x ic)"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAudioPresetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preset 01"
                android:textColor="@color/ad_accent_text"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRadioFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98.5"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="88sp"
                android:fontFamily="@font/atkinson_next_semibold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvRadioFreqUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mhz · stereo broadcast"
                android:textColor="@color/ad_accent_text"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRadioScanDown"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Seek down"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <Button
                android:id="@+id/btnRadioPlay"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1.2"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Play radio"
                android:textColor="@color/ad_accent_text"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <Button
                android:id="@+id/btnRadioScanUp"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Seek up"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
