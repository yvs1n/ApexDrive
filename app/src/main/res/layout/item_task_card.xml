<?xml version="1.0" encoding="utf-8"?>
<!-- Recent app row: surface-1 row, 40 px icon, name and state, Open and Close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ApexDrive.Row"
    android:layout_marginBottom="12dp"
    android:background="@drawable/ad_bg_row_raised">

    <ImageView
        android:id="@+id/ivTaskIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskName"
            style="@style/Widget.ApexDrive.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/atkinson_next_semibold" />

        <TextView
            android:id="@+id/tvTaskStatus"
            style="@style/Widget.ApexDrive.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSwitchTask"
        style="@style/Widget.ApexDrive.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginStart="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Open" />

    <Button
        android:id="@+id/btnCloseTask"
        style="@style/Widget.ApexDrive.Button.Quiet"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginStart="4dp"
        android:text="Close" />
</LinearLayout>
