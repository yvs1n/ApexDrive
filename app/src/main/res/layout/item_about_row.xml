<?xml version="1.0" encoding="utf-8"?>
<!-- One fact on Settings > About: icon, title and a detail that may wrap to two lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ApexDrive.Row"
    android:layout_marginTop="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="false"
    android:focusable="false">

    <ImageView
        android:id="@+id/aboutIcon"
        style="@style/Widget.ApexDrive.RowIcon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aboutTitle"
            style="@style/Widget.ApexDrive.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/aboutDetail"
            style="@style/Widget.ApexDrive.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:maxLines="2"
            android:textIsSelectable="false" />
    </LinearLayout>
</LinearLayout>
