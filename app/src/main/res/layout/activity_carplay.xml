<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCarPlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_bg"
    android:orientation="horizontal">

    <!-- ========================================================
         LEFT DRIVER DOCK (84DP WIDE) - AUTHENTIC APPLE CARPLAY
         ======================================================== -->
    <LinearLayout
        android:id="@+id/dockCarPlay"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cp_dock"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Dock Top: Status Cluster (Clock + Signal + Battery) -->
        <TextView
            android:id="@+id/tvCpClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="18:37"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCpSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="5G ▮▮▮"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="9sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dock Middle: 3 Recent Running Apps (52dp x 52dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 1. OsmAnd Maps -->
            <TextView
                android:id="@+id/btnDockMap"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_cp_squircle_maps"
                android:gravity="center"
                android:text="🗺️"
                android:textSize="24sp" />

            <!-- 2. FM Tuner -->
            <TextView
                android:id="@+id/btnDockRadio"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_squircle_radio"
                android:gravity="center"
                android:text="📻"
                android:textSize="24sp" />

            <!-- 3. Phone -->
            <TextView
                android:id="@+id/btnDockPhone"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_squircle_phone"
                android:gravity="center"
                android:text="📞"
                android:textSize="24sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dock Bottom: Iconic CarPlay Home Button (56dp x 56dp) -->
        <ImageButton
            android:id="@+id/btnCpHome"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_cp_dock_home"
            android:contentDescription="CarPlay Home"
            android:src="@drawable/ic_cp_dots" />

    </LinearLayout>

    <!-- ========================================================
         MAIN CARPLAY STAGE VIEW CONTAINER
         ======================================================== -->
    <FrameLayout
        android:id="@+id/flCpStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- VIEW A: Split Dashboard (Default Visible) -->
        <include
            android:id="@+id/includeDashboard"
            layout="@layout/view_carplay_dashboard" />

        <!-- VIEW B: App Springboard Grid (Default Gone) -->
        <include
            android:id="@+id/includeSpringboard"
            layout="@layout/view_carplay_springboard"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
