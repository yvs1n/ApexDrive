                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lookAccents"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLookWallpaper"
        style="@style/Widget.ApexDrive.Row"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                style="@style/Widget.ApexDrive.RowIcon"
                android:src="@drawable/ic_sym_wallpaper" />

            <TextView
                style="@style/Widget.ApexDrive.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallpaper" />

            <TextView
                android:id="@+id/tvLookWallpaper"
                style="@style/Widget.ApexDrive.RowDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/lookWallpapers"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

