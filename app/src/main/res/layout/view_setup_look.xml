<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Look. Inflated from a ViewStub in view_setup.xml the first time the page is opened. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setPageLook"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/TextAppearance.ApexDrive.Glance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Look" />

    <!-- Live preview: a small Home on the chosen wallpaper. Every change also applies to the whole launcher at once. -->
    <LinearLayout
        android:id="@+id/lookPreview"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:padding="16dp"
>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:elevation="2dp"
            android:background="@drawable/ad_bg_tile">

            <TextView
                style="@style/Widget.ApexDrive.TileHeader"
                app:drawableStartCompat="@drawable/ic_hdr_speed"
                android:text="Speed" />

            <TextView
                style="@style/TextAppearance.ApexDrive.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="48" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:elevation="2dp"
            android:background="@drawable/ad_bg_tile">

            <TextView
                style="@style/Widget.ApexDrive.TileHeader"
                app:drawableStartCompat="@drawable/ic_hdr_phone_iphone"
                android:text="Phone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Widget.ApexDrive.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:importantForAccessibility="no"
                android:text="Open CarPlay" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLookStyle"
        style="@style/Widget.ApexDrive.Row"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                style="@style/Widget.ApexDrive.RowIcon"
                android:src="@drawable/ic_sym_palette" />

            <TextView
                style="@style/Widget.ApexDrive.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Style" />

            <TextView
                android:id="@+id/tvLookStyle"
                style="@style/Widget.ApexDrive.RowDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/ad_bg_segment">

            <TextView
                android:id="@+id/segLookStyle0"
                style="@style/Widget.ApexDrive.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Default" />

            <TextView
                android:id="@+id/segLookStyle1"
                style="@style/Widget.ApexDrive.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="OLED" />

            <TextView
                android:id="@+id/segLookStyle2"
                style="@style/Widget.ApexDrive.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Glass" />

            <TextView
                android:id="@+id/segLookStyle3"
                style="@style/Widget.ApexDrive.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Contrast" />

            <TextView
                android:id="@+id/segLookStyle4"
                style="@style/Widget.ApexDrive.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Warm" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLookAccent"
        style="@style/Widget.ApexDrive.Row"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
