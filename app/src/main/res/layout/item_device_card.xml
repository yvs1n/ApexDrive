<?xml version="1.0" encoding="utf-8"?>
<!-- Phone row in the "Choose a phone" sheet: surface-1 row, icon, name and state, trailing action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ApexDrive.Row"
    android:layout_marginBottom="12dp"
    android:background="@drawable/ad_bg_row_raised"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivDialogDeviceIcon"
        style="@style/Widget.ApexDrive.RowIcon"
        android:src="@drawable/ic_sym_smartphone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDialogDeviceName"
            style="@style/Widget.ApexDrive.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/atkinson_next_semibold" />

        <TextView
            android:id="@+id/tvDialogDeviceStatus"
            style="@style/Widget.ApexDrive.RowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivDialogConnected"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_sym_check_circle"
        app:tint="@color/ad_ok"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <Button
        android:id="@+id/btnConnectPill"
        style="@style/Widget.ApexDrive.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Connect" />

</LinearLayout>
