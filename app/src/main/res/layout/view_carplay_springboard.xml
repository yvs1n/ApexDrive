<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCpSpringboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: 4 Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1. Phone -->
        <LinearLayout
            android:id="@+id/btnAppPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_phone"
                android:gravity="center"
                android:text="📞"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Phone"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2. OsmAnd Maps -->
        <LinearLayout
            android:id="@+id/btnAppMaps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_maps"
                android:gravity="center"
                android:text="🗺️"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="OsmAnd Maps"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 3. FM Radio -->
        <LinearLayout
            android:id="@+id/btnAppRadio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_radio"
                android:gravity="center"
                android:text="📻"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="FM Radio"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. Spotify -->
        <LinearLayout
            android:id="@+id/btnAppSpotify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_spotify"
                android:gravity="center"
                android:text="🎵"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Spotify"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: 4 Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 5. Messages -->
        <LinearLayout
            android:id="@+id/btnAppMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_phone"
                android:gravity="center"
                android:text="💬"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Messages"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 6. Now Playing -->
        <LinearLayout
            android:id="@+id/btnAppNowPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_nowplaying"
                android:gravity="center"
                android:text="🔊"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Now Playing"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 7. Santa Fe (OEM Car App) -->
        <LinearLayout
            android:id="@+id/btnAppSantaFe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_car"
                android:gravity="center"
                android:text="🚗"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Santa Fe"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 8. Cockpit Settings -->
        <LinearLayout
            android:id="@+id/btnAppSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/bg_cp_squircle_settings"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Settings"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Page Indicator Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_elevated_btn" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_inner" />
    </LinearLayout>

</LinearLayout>
