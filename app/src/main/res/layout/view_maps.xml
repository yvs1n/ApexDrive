<?xml version="1.0" encoding="utf-8"?>
<!-- Maps (Audit 2, section 5.3), built from design-system tiles and buttons: 544 + 24 + 328 by 520. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Where to? -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="544"
        android:orientation="vertical"
        android:padding="@dimen/ad_tile_padding"
        android:elevation="2dp"
        android:background="@drawable/ad_bg_tile">

        <TextView
            style="@style/Widget.ApexDrive.TileHeader"
            app:drawableStartCompat="@drawable/ic_hdr_navigation"
            android:text="Where to?" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnNavHome"
                style="@style/Widget.ApexDrive.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/ic_btn_home"
                android:text="Home" />

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnNavWork"
                style="@style/Widget.ApexDrive.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:drawableStartCompat="@drawable/ic_btn_work"
                android:text="Work" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnNavFuel"
                style="@style/Widget.ApexDrive.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/ic_btn_local_gas_station"
                android:text="Fuel" />

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnNavParking"
                style="@style/Widget.ApexDrive.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:drawableStartCompat="@drawable/ic_btn_local_parking"
                android:text="Parking" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnNavCoffee"
                style="@style/Widget.ApexDrive.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/ic_btn_local_cafe"
                android:text="Coffee" />

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnNavHospital"
                style="@style/Widget.ApexDrive.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:drawableStartCompat="@drawable/ic_btn_local_hospital"
                android:text="Hospital" />
        </LinearLayout>

        <TextView
            style="@style/Widget.ApexDrive.TileHeader"
            android:layout_marginTop="24dp"
            android:text="Recent" />

        <TextView
            style="@style/TextAppearance.ApexDrive.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ad_label_3"
            android:text="Places you visit appear here." />
    </LinearLayout>

    <!-- Here -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="328"
        android:layout_marginStart="@dimen/ad_tile_gap"
        android:orientation="vertical"
        android:padding="@dimen/ad_tile_padding"
        android:elevation="2dp"
        android:background="@drawable/ad_bg_tile">

        <TextView
            style="@style/Widget.ApexDrive.TileHeader"
            app:drawableStartCompat="@drawable/ic_hdr_map"
            android:text="Here" />

        <TextView
            android:id="@+id/tvNavHeadingBig"
            style="@style/TextAppearance.ApexDrive.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="–" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivNavGpsDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ad_dot"
                app:tint="@color/ad_label_3"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvNavAccuracy"
                style="@style/Widget.ApexDrive.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/ad_text_label"
                android:text="GPS none" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNavTripDist"
                style="@style/Widget.ApexDrive.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip 0.0 km" />

            <TextView
                android:id="@+id/tvNavTripDuration"
                style="@style/Widget.ApexDrive.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="0 min" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.apexdrive.launcher.ui.CenteredIconButton
            android:id="@+id/btnOpenOsmAnd"
            style="@style/Widget.ApexDrive.Button.Primary"
            android:layout_width="match_parent"
            app:drawableStartCompat="@drawable/ic_btn_map"
            android:text="Open map" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMapStatusBadge"
                style="@style/TextAppearance.ApexDrive.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/ad_label_2"
                android:text="OsmAnd" />

            <Button
                android:id="@+id/btnChooseMapApp"
                style="@style/Widget.ApexDrive.Button.Quiet"
                android:layout_width="wrap_content"
                android:text="Change app" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
