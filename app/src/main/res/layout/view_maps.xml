<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left Stage: Live Dynamic GPS Tactical Navigation Stage -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <!-- Stage Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live GPS telemetry &amp; navigation"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvNavAccuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_inner"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="● 3D Fix · ±3m"
                android:textColor="@color/status_active"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Live Dynamic Compass & Heading Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_inner"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvNavHeadingBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="North 0°"
                android:textColor="@color/ad_accent_text"
                android:textSize="32sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <TextView
                android:id="@+id/tvNavCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Searching Satellite Coordinates..."
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_medium" />

            <TextView
                android:id="@+id/tvNavAltitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Altitude: -- m  ·  Speed: 0 KM/H"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_regular" />

            <!-- Direct Launch into CarPlay Navigation (Big Finger Friendly 60dp) -->
            <Button
                android:id="@+id/btnNavCarPlayRoute"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Open CarPlay navigation"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />

        </LinearLayout>

        <!-- Live Trip Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_inner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvNavTripDist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trip: 0.0 km"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <TextView
                android:id="@+id/tvNavTripDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration: 0 min"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Space -->
    <View
        android:layout_width="10dp"
        android:layout_height="match_parent" />

    <!-- Right Stage: Dynamic Quick Destination & Map Launcher Hub -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick destinations &amp; apps"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- 1-Tap POI Quick Triggers (Uses system GPS geo: intent - Big Finger Friendly 58dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNavFuel"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Fuel station"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <Button
                android:id="@+id/btnNavParking"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Parking"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNavCoffee"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Rest area"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />

            <Button
                android:id="@+id/btnNavHospital"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
                android:text="Hospital"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/atkinson_next_semibold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Primary navigation engine"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Primary Hero Button: OsmAnd Offline Navigation -->
        <Button
            android:id="@+id/btnOpenOsmAnd"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="Launch OsmAnd offline"
            android:textColor="@color/ad_accent_text"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <TextView
            android:id="@+id/tvMapStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="● radars · road bumps · offline lanes active"
            android:textColor="@color/status_active"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <Button
            android:id="@+id/btnChooseMapApp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="Change default map engine"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

    </LinearLayout>

</LinearLayout>
