<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left Stage: Live Dynamic GPS Tactical Navigation Stage -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <!-- Stage Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE GPS TELEMETRY &amp; NAVIGATION"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvNavAccuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_inner"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="● 3D Fix · ±3m"
                android:textColor="@color/status_active"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Live Dynamic Compass & Heading Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_inner"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvNavHeadingBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NORTH 0°"
                android:textColor="@color/accent_amber"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvNavCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Searching Satellite Coordinates..."
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvNavAltitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Altitude: -- m  ·  Speed: 0 KM/H"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />

            <!-- Direct Launch into CarPlay Navigation (Big Finger Friendly 52dp) -->
            <Button
                android:id="@+id/btnNavCarPlayRoute"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="OPEN CARPLAY NAVIGATION"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:paddingStart="26dp"
                android:paddingEnd="26dp" />

        </LinearLayout>

        <!-- Live Trip Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_inner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvNavTripDist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRIP: 0.0 KM"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvNavTripDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION: 0 MIN"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

    </LinearLayout>

    <!-- Space -->
    <View
        android:layout_width="10dp"
        android:layout_height="match_parent" />

    <!-- Right Stage: Dynamic Quick Destination & Map Launcher Hub -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK DESTINATIONS &amp; APPS"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- 1-Tap POI Quick Triggers (Uses system GPS geo: intent - Big Finger Friendly 52dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNavFuel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_elevated_btn"
                android:text="FUEL STATION"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />

            <Button
                android:id="@+id/btnNavParking"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="PARKING"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNavCoffee"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_elevated_btn"
                android:text="REST AREA"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />

            <Button
                android:id="@+id/btnNavHospital"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_elevated_btn"
                android:text="HOSPITAL"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="INSTALLED NAVIGATION ENGINES"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/cockpit_surface_border_subtle" />

        <Button
            android:id="@+id/btnOpenGoogleMaps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="GOOGLE MAPS"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08" />

        <Button
            android:id="@+id/btnOpenWaze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="WAZE NAVIGATION"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08" />

    </LinearLayout>

</LinearLayout>
