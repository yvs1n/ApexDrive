<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="20dp"
    android:minWidth="480dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select driver phone"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <TextView
            android:id="@+id/tvCountdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto in 8s"
            android:textColor="@color/ad_accent_text"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap your phone to lock Bluetooth &amp; CarPlay. Prevents hijacking other phones in the car."
        android:textColor="@color/cockpit_text_secondary"
        android:textSize="20sp"
        android:fontFamily="@font/atkinson_next_regular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/cockpit_surface_border_subtle" />

    <!-- Loading State While Bluetooth Stack Initializes at Boot -->
    <LinearLayout
        android:id="@+id/layoutDeviceLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbDeviceLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvDeviceLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Initializing Bluetooth &amp; detecting phones..."
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Waking head unit Bluetooth stack · Detecting paired driver phones"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_regular" />
    </LinearLayout>

    <!-- Container for Paired Phone Cards (Big Fingers Friendly) -->
    <LinearLayout
        android:id="@+id/deviceListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/cockpit_surface_border_subtle" />

    <!-- Action Buttons (Large Touch Targets >= 54dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnPairNewDevice"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="Pair new phone"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <Button
            android:id="@+id/btnSkipSelector"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.2"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="Continue to dashboard"
            android:textColor="@color/ad_accent_text"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />
    </LinearLayout>

</LinearLayout>
