<?xml version="1.0" encoding="utf-8"?>
<!-- "Choose a phone" sheet, as drawn in design/design-system.html (tpl-sheet-overlay): 560 x 448 glass. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="560dp"
    android:layout_height="448dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/ad_bg_glass_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp">

        <TextView
            style="@style/TextAppearance.ApexDrive.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choose a phone" />

        <ImageButton
            android:id="@+id/btnSkipSelector"
            style="@style/Widget.ApexDrive.IconButton"
            android:background="@drawable/ad_bg_btn_close"
            android:src="@drawable/ic_sym_close"
            android:contentDescription="Close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDeviceLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ad_row_height"
        android:paddingStart="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbDeviceLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvDeviceLoadingText"
            style="@style/TextAppearance.ApexDrive.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/ad_label_2"
            android:text="Looking for paired phones" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/deviceListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.apexdrive.launcher.ui.CenteredIconButton
        android:id="@+id/btnPairNewDevice"
        style="@style/Widget.ApexDrive.Button"
        android:layout_width="wrap_content"
        android:layout_marginTop="12dp"
        app:drawableStartCompat="@drawable/ic_btn_add"
        android:text="Pair a phone" />

</LinearLayout>
