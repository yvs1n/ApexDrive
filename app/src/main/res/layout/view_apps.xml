<?xml version="1.0" encoding="utf-8"?>
<!-- Apps, as drawn in design/design-system.html (tpl-apps): search + 5-column grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/fieldSearchApps"
        android:layout_width="420dp"
        android:layout_height="@dimen/ad_target"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/ad_bg_field">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sym_search"
            app:tint="@color/ad_label_3"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/etSearchApps"
            style="@style/TextAppearance.ApexDrive.Label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="Search apps"
            android:textColorHint="@color/ad_label_3"
            android:padding="0dp"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </LinearLayout>

    <GridView
        android:id="@+id/gvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:numColumns="5"
        android:horizontalSpacing="16dp"
        android:verticalSpacing="16dp"
        android:stretchMode="columnWidth"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none"
        android:overScrollMode="never" />

</LinearLayout>
