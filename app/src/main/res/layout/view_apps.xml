<?xml version="1.0" encoding="utf-8"?>
<!-- Apps, as drawn in design/design-system.html (tpl-apps). Parked: search + 5-column grid.
     Driving: banner + 6 favourites in a 3 x 2 grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/fieldSearchApps"
        android:layout_width="420dp"
        android:layout_height="@dimen/ad_target"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/ad_bg_field">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sym_search"
            app:tint="@color/ad_label_3"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/etSearchApps"
            style="@style/TextAppearance.ApexDrive.Label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="Search apps"
            android:textColorHint="@color/ad_label_3"
            android:padding="0dp"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bannerDrivingApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp"
        android:visibility="gone"
        android:background="@drawable/ad_bg_glass_capsule">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ad_bg_badge">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sym_lock_fill"
                app:tint="@color/ad_label_1"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.ApexDrive.Glance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 favourites while driving" />

            <TextView
                style="@style/TextAppearance.ApexDrive.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ad_label_2"
                android:text="Search and the full list come back when you stop." />
        </LinearLayout>
    </LinearLayout>

    <GridView
        android:id="@+id/gvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:numColumns="5"
        android:horizontalSpacing="16dp"
        android:verticalSpacing="16dp"
        android:stretchMode="columnWidth"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none"
        android:overScrollMode="never" />

</LinearLayout>
