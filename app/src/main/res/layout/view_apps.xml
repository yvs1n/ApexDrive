<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/ad_shell_inset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ad_target"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvInstalledAppsTitle"
            style="@style/TextAppearance.ApexDrive.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apps" />

        <EditText
            android:id="@+id/etSearchApps"
            style="@style/TextAppearance.ApexDrive.Body"
            android:layout_width="320dp"
            android:layout_height="@dimen/ad_target"
            android:background="@drawable/bg_card_inner"
            android:hint="Search apps"
            android:textColorHint="@color/ad_label_3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:maxLines="1"
            android:inputType="text" />
    </LinearLayout>

    <GridView
        android:id="@+id/gvApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ad_tile_gap"
        android:numColumns="5"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:stretchMode="columnWidth"
        android:gravity="center" />

</LinearLayout>
