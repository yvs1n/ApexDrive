<?xml version="1.0" encoding="utf-8"?>
<!-- Shell from design/design-system.html: floating glass rail (8 px inset, 96 wide),
     floating glass status capsule (52 tall) and a 896 x 520 content area. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ad_canvas">

    <!-- Content -->
    <FrameLayout
        android:id="@+id/viewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="120dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Rail -->
    <LinearLayout
        android:id="@+id/driverRail"
        android:layout_width="@dimen/ad_rail_glass_width"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="8dp"
        android:elevation="6dp"
        android:background="@drawable/ad_bg_glass_panel">

        <include layout="@layout/merge_rail_items" />
    </LinearLayout>

    <!-- Status bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ad_status_bar_height"
        android:layout_marginStart="120dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:elevation="6dp"
        android:background="@drawable/ad_bg_glass_capsule">

        <TextView
            android:id="@+id/tvClock"
            style="@style/TextAppearance.ApexDrive.Glance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/atkinson_next_semibold"
            android:text="12:45" />

        <!-- Temperature -->
        <LinearLayout
            android:id="@+id/pillHeaderWeather"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ad_bg_btn_quiet"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_sym_thermostat"
                android:tint="@color/ad_label_1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWeatherText"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/atkinson_next_medium"
                android:text="–" />
        </LinearLayout>

        <!-- GPS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivGpsDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ad_dot"
                android:tint="@color/ad_label_3"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvGps"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/atkinson_next_medium"
                android:text="GPS" />
        </LinearLayout>

        <!-- Phone -->
        <LinearLayout
            android:id="@+id/pillHeaderBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ad_bg_btn_quiet"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivHeaderBtIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ad_dot"
                android:tint="@color/ad_label_3"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvHeaderBluetooth"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxWidth="220dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/atkinson_next_medium"
                android:text="No phone" />
        </LinearLayout>

        <!-- Retired from the status bar; kept for the code that still addresses them. -->
        <LinearLayout
            android:id="@+id/btnHeaderRecents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivHeaderRecentsIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvHeaderRecentsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVehicleModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
