<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cockpit_surface_base">

    <!-- Top Swiss Cockpit Header (Translucent Smoked Glass) -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_panel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Swiss High-Contrast Clock (Bold Grotesque Numerals) -->
        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black" />

        <!-- Santa Fe Model Pill -->
        <TextView
            android:id="@+id/tvVehicleModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="SANTA FE · IX45"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Weather Status Pill (Top Bar) -->
        <LinearLayout
            android:id="@+id/pillHeaderWeather"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_inner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEMP"
                android:textColor="@color/accent_amber"
                android:textSize="9sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvWeatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="26°C · OUTSIDE"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Bluetooth Connected Device Header Pill (Clickable) -->
        <LinearLayout
            android:id="@+id/pillHeaderBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_inner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivHeaderBtIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_nav_bluetooth"
                android:contentDescription="Bluetooth" />

            <TextView
                android:id="@+id/tvHeaderBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NOT CONNECTED"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

    </LinearLayout>

    <!-- Cockpit Body: Driver Rail (Left) + Content Stage (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Driver Navigation Rail (Swiss Grid & Big Fingers Friendly) -->
        <LinearLayout
            android:id="@+id/driverRail"
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_panel"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- 1. DASHBOARD -->
            <LinearLayout
                android:id="@+id/railBtnDash"
                android:layout_width="74dp"
                android:layout_height="58dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDashIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_dash"
                    android:contentDescription="Dash" />

                <TextView
                    android:id="@+id/tvDashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="DASH"
                    android:textColor="@color/accent_amber"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- 2. CARPLAY -->
            <LinearLayout
                android:id="@+id/railBtnCarPlay"
                android:layout_width="74dp"
                android:layout_height="58dp"
                android:layout_marginTop="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivCarPlayIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_carplay"
                    android:contentDescription="CarPlay" />

                <TextView
                    android:id="@+id/tvCarPlayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PHONE"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- 3. MAPS -->
            <LinearLayout
                android:id="@+id/railBtnMaps"
                android:layout_width="74dp"
                android:layout_height="58dp"
                android:layout_marginTop="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivMapsIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_maps"
                    android:contentDescription="Maps" />

                <TextView
                    android:id="@+id/tvMapsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MAPS"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- 4. AUDIO -->
            <LinearLayout
                android:id="@+id/railBtnAudio"
                android:layout_width="74dp"
                android:layout_height="58dp"
                android:layout_marginTop="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAudioIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_audio"
                    android:contentDescription="Audio" />

                <TextView
                    android:id="@+id/tvAudioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="AUDIO"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- 5. APPS -->
            <LinearLayout
                android:id="@+id/railBtnApps"
                android:layout_width="74dp"
                android:layout_height="58dp"
                android:layout_marginTop="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAppsIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_apps"
                    android:contentDescription="Apps" />

                <TextView
                    android:id="@+id/tvAppsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="APPS"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Flexible Spacer -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 6. SETUP -->
            <LinearLayout
                android:id="@+id/railBtnSetup"
                android:layout_width="74dp"
                android:layout_height="58dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSetupIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_setup"
                    android:contentDescription="Setup" />

                <TextView
                    android:id="@+id/tvSetupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SETUP"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Dynamic Main View Stage -->
        <FrameLayout
            android:id="@+id/viewContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
