<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cockpit_surface_base">

    <!-- Top Automotive Cockpit Header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cockpit_surface_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVehicleModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Santa Fe (IX45)"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="|"
            android:textColor="@color/cockpit_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="28°C"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Bluetooth Device Header Status -->
        <TextView
            android:id="@+id/tvHeaderBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BT: SantafemR"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- GPS Fix Status -->
        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="GPS 3D"
            android:textColor="@color/status_active"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cockpit_surface_border_subtle" />

    <!-- Cockpit Body: Left Driver Rail + Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Driver Navigation Rail (Ergonomic for Left-Hand Drive) -->
        <LinearLayout
            android:id="@+id/driverRail"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/cockpit_surface_panel"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/railBtnDash"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvDashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dash"
                    android:textColor="@color/accent_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railBtnCarPlay"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvCarPlayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CarPlay"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railBtnMaps"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvMapsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maps"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railBtnAudio"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvAudioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railBtnApps"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvAppsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/railBtnSetup"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_elevated_btn"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvSetupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setup"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/cockpit_surface_border_subtle" />

        <!-- Dynamic Main View Container -->
        <FrameLayout
            android:id="@+id/viewContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
