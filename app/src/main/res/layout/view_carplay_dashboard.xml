<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCpDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- ========================================================
         LEFT HERO CARD: REAL-TIME OSMAND OFFLINE MAP (58%)
         ======================================================== -->
    <RelativeLayout
        android:id="@+id/cardCpMap"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_weight="58"
        android:background="@drawable/bg_cp_card"
        android:padding="12dp">

        <!-- Top Maneuver Banner (High-contrast Apple Maps Style) -->
        <LinearLayout
            android:id="@+id/llCpManeuver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_cp_maneuver"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Green Turn Arrow Box -->
            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_cp_squircle_phone"
                android:gravity="center"
                android:text="⬆"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCpManeuverDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="In 450 m"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvCpManeuverStreet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Take Exit 36 toward Hessa St / Dubai Marina"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speed Limit Sign + Radar Alert Pill -->
        <LinearLayout
            android:id="@+id/llCpTelemetryBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/llCpManeuver"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 100 KM/H Speed Sign -->
            <TextView
                android:id="@+id/tvCpSpeedLimit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_cp_speed_limit"
                android:gravity="center"
                android:text="100"
                android:textColor="#000000"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black" />

            <!-- Active Radar Camera Warning Pill -->
            <TextView
                android:id="@+id/tvCpRadarAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_cp_radar_pill"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="● RADAR 280M AHEAD · 100 KM/H"
                android:textColor="#FF453A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Center OsmAnd Launch Helper Prompt -->
        <TextView
            android:id="@+id/tvCpMapCenterHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="SHEIKH ZAYED RD · E11\n[TAP TO EXPAND OSMAND OFFLINE MAP]"
            android:textColor="@color/cockpit_text_tertiary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08" />

        <!-- Bottom Row: Real-Time GPS Speedometer + OsmAnd Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Real-Time Speedometer Cluster -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_inner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvCpSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvCpSpeedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="KM/H"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- OsmAnd Offline Status Badge Button -->
            <Button
                android:id="@+id/btnCpOsmAndStatus"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_card_inner"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="● OSMAND OFFLINE · UAE ACTIVE"
                android:textColor="@color/cp_accent_green"
                android:textSize="10sp" />
        </LinearLayout>

    </RelativeLayout>

    <!-- ========================================================
         RIGHT COLUMN STACK: ETA & MEDIA (42%)
         ======================================================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="42"
        android:orientation="vertical">

        <!-- CARD 1: ROUTE & ETA OVERVIEW (TOP) -->
        <LinearLayout
            android:id="@+id/cardCpEta"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cp_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCpEtaTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="18:51"
                        android:textColor="@color/cockpit_text_primary"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvCpEtaSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="14 min · 12.8 km remaining"
                        android:textColor="@color/cp_accent_green"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_inner"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Dubai Marina Mall"
                        android:textColor="@color/cockpit_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Sheikh Zayed Rd"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 4 Quick Offline POI Lookups -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCpPoiFuel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cp_poi_btn"
                    android:fontFamily="sans-serif-bold"
                    android:text="⛽ FUEL"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnCpPoiPark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cp_poi_btn"
                    android:fontFamily="sans-serif-bold"
                    android:text="🅿️ PARK"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnCpPoiCoffee"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cp_poi_btn"
                    android:fontFamily="sans-serif-bold"
                    android:text="☕ REST"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnCpPoiClinic"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cp_poi_btn"
                    android:fontFamily="sans-serif-bold"
                    android:text="🏥 CLINIC"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2: NOW PLAYING & RADIO TUNER (BOTTOM) -->
        <LinearLayout
            android:id="@+id/cardCpMedia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_cp_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Artwork / Tuner Badge -->
                <TextView
                    android:id="@+id/ivCpMediaArt"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_cp_squircle_radio"
                    android:gravity="center"
                    android:text="📻"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCpMediaTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:text="FM 98.5 MHz"
                        android:textColor="@color/cockpit_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvCpMediaArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Radio Tuner Broadcast"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCpMediaSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:text="● HARDWARE TUNER (SI473X)"
                        android:textColor="@color/cp_accent_orange"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Transport Controls (Large Touch Friendly Automotive Targets) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Prev / Tune Down -->
                <Button
                    android:id="@+id/btnCpMediaPrev"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_cp_poi_btn"
                    android:text="⏮"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <!-- Play / Pause (Background Tuner Control) -->
                <Button
                    android:id="@+id/btnCpMediaPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_elevated_btn"
                    android:text="PAUSE"
                    android:textColor="@color/accent_amber"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black" />

                <!-- Next / Tune Up -->
                <Button
                    android:id="@+id/btnCpMediaNext"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_cp_poi_btn"
                    android:text="⏭"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Audio Source Toggle (Radio vs Spotify) -->
                <Button
                    android:id="@+id/btnCpMediaSourceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_card_inner"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="SOURCE"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
