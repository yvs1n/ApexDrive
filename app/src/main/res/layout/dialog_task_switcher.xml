<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="20dp"
    android:minWidth="520dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivSwitcherIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_nav_recents"
            android:contentDescription="Task Switcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Active background apps"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <TextView
            android:id="@+id/tvRecentsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 running"
            android:textColor="@color/ad_accent_text"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Switch directly to an active task or close background apps to free RAM on the head unit."
        android:textColor="@color/cockpit_text_secondary"
        android:textSize="20sp"
        android:fontFamily="@font/atkinson_next_regular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/cockpit_surface_border_subtle" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvNoRecentTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No active background apps detected.\nAll system resources are optimized."
        android:textColor="@color/cockpit_text_secondary"
        android:textSize="20sp"
        android:fontFamily="@font/atkinson_next_regular"
        android:visibility="gone" />

    <!-- Scrollable Tasks List (Big Touch Targets) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp">

        <LinearLayout
            android:id="@+id/llTasksList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/cockpit_surface_border_subtle" />

    <!-- Action Buttons (Large Touch Targets >= 52dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnCloseAllTasks"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="Close all apps"
            android:textColor="@color/accent_sport_red"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <Button
            android:id="@+id/btnSystemRecents"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="System ui"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold" />

        <Button
            android:id="@+id/btnDismissSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_elevated_btn"
        android:textAllCaps="false"
            android:text="Return"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="20sp"
            android:fontFamily="@font/atkinson_next_semibold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
