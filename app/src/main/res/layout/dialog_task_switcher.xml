<?xml version="1.0" encoding="utf-8"?>
<!-- Recent apps, as a design-system glass sheet (same pattern as "Choose a phone"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/ad_bg_glass_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp">

        <TextView
            style="@style/TextAppearance.ApexDrive.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recent apps" />

        <TextView
            android:id="@+id/tvRecentsBadge"
            style="@style/Widget.ApexDrive.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="" />

        <ImageButton
            android:id="@+id/btnDismissSwitcher"
            style="@style/Widget.ApexDrive.IconButton"
            android:background="@drawable/ad_bg_btn_close"
            android:src="@drawable/ic_sym_close"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoRecentTasks"
        style="@style/TextAppearance.ApexDrive.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:textColor="@color/ad_label_2"
        android:text="No recent apps."
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="300dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/llTasksList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCloseAllTasks"
            style="@style/Widget.ApexDrive.Button"
            android:layout_width="wrap_content"
            android:text="Close all" />

        <Button
            android:id="@+id/btnSystemRecents"
            style="@style/Widget.ApexDrive.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:text="System recents" />
    </LinearLayout>
</LinearLayout>
