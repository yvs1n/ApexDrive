<?xml version="1.0" encoding="utf-8"?>
<!-- App tile (.apptile): surface-1, tile radius, 72 px icon, 22 px semibold label, 10 px gap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ad_app_tile_height"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:elevation="2dp"
    android:focusable="true"
    android:background="@drawable/ad_bg_tile_pressable">

    <ImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvAppName"
        style="@style/TextAppearance.ApexDrive.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/atkinson_next_semibold"
        android:maxWidth="160dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:gravity="center" />

</LinearLayout>
