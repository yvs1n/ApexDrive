<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="106dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <!-- Apple/Swiss Continuous Squircle Icon Container (64dp x 64dp) -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_squircle"
        android:padding="9dp">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="App Icon" />
    </FrameLayout>

    <!-- App Name Label (Optical Sizing: 12sp, Swiss medium, crisp) -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="92dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:gravity="center"
        android:textColor="@color/cockpit_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
