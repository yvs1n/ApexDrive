<?xml version="1.0" encoding="utf-8"?>
<!-- Home, as drawn in design/design-system.html (tpl-home): 544 + 24 + 328 by 248 + 24 + 248. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Drive -->
        <LinearLayout
            android:id="@+id/tileDrive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="544"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:elevation="2dp"
            android:background="@drawable/ad_bg_tile">

            <TextView
                style="@style/Widget.ApexDrive.TileHeader"
                app:drawableStartCompat="@drawable/ic_hdr_navigation"
                android:text="Drive" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ad_target"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.apexdrive.launcher.ui.CenteredIconButton
                    android:id="@+id/btnPlaceHome"
                    style="@style/Widget.ApexDrive.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:drawableStartCompat="@drawable/ic_btn_home"
                    android:text="Home" />

                <com.apexdrive.launcher.ui.CenteredIconButton
                    android:id="@+id/btnPlaceWork"
                    style="@style/Widget.ApexDrive.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:drawableStartCompat="@drawable/ic_btn_work"
                    android:text="Work" />

                <com.apexdrive.launcher.ui.CenteredIconButton
                    android:id="@+id/btnPlaceFuel"
                    style="@style/Widget.ApexDrive.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:drawableStartCompat="@drawable/ic_btn_local_gas_station"
                    android:text="Fuel" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.apexdrive.launcher.ui.CenteredIconButton
                    android:id="@+id/btnOpenMapsHome"
                    style="@style/Widget.ApexDrive.Button.Quiet"
                    android:layout_width="wrap_content"
                    app:drawableStartCompat="@drawable/ic_btn_map"
                    android:text="Open Maps" />

                <TextView
                    android:id="@+id/tvLastRoute"
                    style="@style/TextAppearance.ApexDrive.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/ad_label_3"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speed -->
        <LinearLayout
            android:id="@+id/tileSpeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="328"
            android:layout_marginStart="@dimen/ad_tile_gap"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:elevation="2dp"
            android:background="@drawable/ad_bg_tile">

            <TextView
                style="@style/Widget.ApexDrive.TileHeader"
                app:drawableStartCompat="@drawable/ic_hdr_speed"
                android:text="Speed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/tvSpeed"
                    style="@style/TextAppearance.ApexDrive.Speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–" />

                <TextView
                    android:id="@+id/tvSpeedUnit"
                    style="@style/TextAppearance.ApexDrive.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/atkinson_next_medium"
                    android:textColor="@color/ad_label_2"
                    android:text="km/h" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/rowTripContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTripDistance"
                    style="@style/Widget.ApexDrive.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trip 0.0 km" />

                <TextView
                    android:id="@+id/tvAvgSpeed"
                    style="@style/Widget.ApexDrive.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg –" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTripTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/ad_tile_gap"
        android:orientation="horizontal">

        <!-- Now playing: art fills the full tile height, flush left, clipped by the tile corners. -->
        <LinearLayout
            android:id="@+id/tileNowPlaying"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="544"
            android:orientation="horizontal"
            android:elevation="2dp"
            android:background="@drawable/ad_bg_tile">

            <FrameLayout
                android:layout_width="248dp"
                android:layout_height="match_parent"
                android:background="@color/ad_surface_3">

                <ImageView
                    android:id="@+id/ivAlbumArtPlaceholder"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sym_music_note"
                    app:tint="@color/ad_label_3"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/ivAlbumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvTrackTitle"
                    style="@style/TextAppearance.ApexDrive.Glance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/atkinson_next_semibold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Nothing playing" />

                <TextView
                    android:id="@+id/tvTrackArtist"
                    style="@style/TextAppearance.ApexDrive.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/atkinson_next_regular"
                    android:textColor="@color/ad_label_2"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Play something on your phone" />

                <TextView
                    android:id="@+id/tvTrackSource"
                    style="@style/TextAppearance.ApexDrive.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ad_label_3"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMediaPrev"
                        style="@style/Widget.ApexDrive.IconButton"
                        android:src="@drawable/ic_sym_skip_previous_fill"
                        android:contentDescription="Previous" />

                    <ImageButton
                        android:id="@+id/btnMediaPlayPause"
                        style="@style/Widget.ApexDrive.IconButton"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_sym_play_arrow_fill"
                        android:contentDescription="Play" />

                    <ImageButton
                        android:id="@+id/btnMediaNext"
                        style="@style/Widget.ApexDrive.IconButton"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_sym_skip_next_fill"
                        android:contentDescription="Next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Phone -->
        <LinearLayout
            android:id="@+id/cardBluetooth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="328"
            android:layout_marginStart="@dimen/ad_tile_gap"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:elevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ad_bg_tile_pressable">

            <TextView
                style="@style/Widget.ApexDrive.TileHeader"
                app:drawableStartCompat="@drawable/ic_hdr_phone_iphone"
                android:text="Phone" />

            <TextView
                android:id="@+id/tvBtDeviceName"
                style="@style/TextAppearance.ApexDrive.Glance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/atkinson_next_semibold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="No phone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivBtStatusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ad_dot"
                    app:tint="@color/ad_label_3"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvBtStatusBadge"
                    style="@style/Widget.ApexDrive.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="@dimen/ad_text_label"
                    android:text="Not connected" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBtProfileDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.apexdrive.launcher.ui.CenteredIconButton
                android:id="@+id/btnLaunchCarPlay"
                style="@style/Widget.ApexDrive.Button.Primary"
                android:layout_width="match_parent"
                app:drawableStartCompat="@drawable/ic_btn_cast"
                android:text="Open CarPlay" />

            <TextView
                android:id="@+id/tvCarPlayReadyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCarPlayProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
