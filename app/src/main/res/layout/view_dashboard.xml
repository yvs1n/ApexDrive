<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- LEFT COLUMN STACK: CarPlay (Hero) + Bluetooth Compact Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <!-- Left Top: Apple CarPlay / Mobile Projection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_panel">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOBILE PROJECTION"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvCarPlayProtocol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZLINK 5.3"
                    android:textColor="@color/accent_amber"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cockpit_surface_border_subtle" />

            <!-- Inner Frosted Stage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_inner"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvCarPlayReadyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●  Phone Link Active"
                    android:textColor="@color/status_active"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Swiss Bold Headline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="CarPlay · Android Auto"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Seamless navigation, Spotify &amp; Siri interface"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />

                <Button
                    android:id="@+id/btnLaunchCarPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_elevated_btn"
                    android:text="LAUNCH CARPLAY"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Left Bottom: Compact Bluetooth Card (Clickable, Big Finger Friendly 64dp) -->
        <LinearLayout
            android:id="@+id/cardBluetooth"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_panel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_bluetooth"
                android:contentDescription="Bluetooth" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBtDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SantafemR"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvBtProfileDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A2DP Audio &amp; Calls Active"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_elevated_btn"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="● CONNECTED"
                android:textColor="@color/status_active"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Space between columns -->
    <View
        android:layout_width="10dp"
        android:layout_height="match_parent" />

    <!-- RIGHT COLUMN STACK: Speedometer (Top) + Media Player (Bottom) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Right Top: Swiss Telemetry & Speedometer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS VELOCITY"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Dynamic Heading Badge -->
                <TextView
                    android:id="@+id/tvHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_inner"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="NW 315°"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>

            <!-- Large Swiss Tabular Speedometer Numerals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="74sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvSpeedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_elevated_btn"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="KM/H"
                    android:textColor="@color/accent_amber"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cockpit_surface_border_subtle" />

            <LinearLayout
                android:id="@+id/rowTripContainer"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTripDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trip: 0.0 km"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvTripTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time: 0 min (Tap to reset)"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right Bottom: Universal Media Controller -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNIVERSAL AUDIO"
                    android:textColor="@color/accent_amber"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTrackTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track / Radio"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-black"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTrackArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap Play to resume Spotify, Radio or CarPlay"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Touch Transport Buttons (Big Finger Friendly 54dp height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnMediaPrev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_elevated_btn"
                    android:text="⏮"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnMediaPlayPause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_elevated_btn"
                    android:text="⏯  PAUSE / PLAY"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black" />

                <Button
                    android:id="@+id/btnMediaNext"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_elevated_btn"
                    android:text="⏭"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
