<?xml version="1.0" encoding="utf-8"?>
<!-- Home: four tiles on the 8 px grid. Content area is 896 x 520 inside a 16 px inset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/ad_shell_inset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Drive -->
        <LinearLayout
            android:id="@+id/tileDrive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:background="@drawable/bg_panel">

            <TextView
                style="@style/TextAppearance.ApexDrive.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drive" />

            <TextView
                android:id="@+id/tvDriveTitle"
                style="@style/TextAppearance.ApexDrive.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Where to?" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnOpenMapsHome"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ad_target"
                android:background="@drawable/ad_bg_btn_primary"
                android:textColor="@color/ad_on_accent"
                android:textAllCaps="false"
                android:text="Open maps" />
        </LinearLayout>

        <!-- Speed -->
        <LinearLayout
            android:id="@+id/tileSpeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/ad_tile_gap"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:background="@drawable/bg_panel">

            <TextView
                style="@style/TextAppearance.ApexDrive.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvSpeed"
                    style="@style/TextAppearance.ApexDrive.Speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--" />

                <TextView
                    android:id="@+id/tvSpeedUnit"
                    style="@style/TextAppearance.ApexDrive.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ad_target"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="km/h"
                    android:textColor="@color/ad_accent_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTripContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTripDistance"
                    style="@style/TextAppearance.ApexDrive.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trip 0.0 km" />

                <TextView
                    android:id="@+id/tvTripTime"
                    style="@style/TextAppearance.ApexDrive.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="0 min" />
            </LinearLayout>

            <!-- Kept for the GPS code; no compass line on Home. -->
            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/ad_tile_gap"
        android:orientation="horizontal">

        <!-- Now playing: art fills the full tile height, flush left -->
        <LinearLayout
            android:id="@+id/tileNowPlaying"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel">

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="246dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/ad_surface_3"
                android:src="@drawable/ic_sym_music_note"
                android:padding="72dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/ad_tile_padding">

                <TextView
                    android:id="@+id/tvTrackTitle"
                    style="@style/TextAppearance.ApexDrive.Glance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Nothing playing" />

                <TextView
                    android:id="@+id/tvTrackArtist"
                    style="@style/TextAppearance.ApexDrive.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Play something on your phone or pick a source" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ad_target"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMediaPrev"
                        style="@style/TextAppearance.ApexDrive.Label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/ad_bg_btn_secondary"
                        android:textAllCaps="false"
                        android:text="Prev" />

                    <Button
                        android:id="@+id/btnMediaPlayPause"
                        style="@style/TextAppearance.ApexDrive.Label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ad_bg_btn_primary"
                        android:textColor="@color/ad_on_accent"
                        android:textAllCaps="false"
                        android:text="Play" />

                    <Button
                        android:id="@+id/btnMediaNext"
                        style="@style/TextAppearance.ApexDrive.Label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/ad_bg_btn_secondary"
                        android:textAllCaps="false"
                        android:text="Next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Phone -->
        <LinearLayout
            android:id="@+id/cardBluetooth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/ad_tile_gap"
            android:orientation="vertical"
            android:padding="@dimen/ad_tile_padding"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/TextAppearance.ApexDrive.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone" />

            <TextView
                android:id="@+id/tvBtDeviceName"
                style="@style/TextAppearance.ApexDrive.Glance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No phone connected" />

            <TextView
                android:id="@+id/tvBtProfileDetail"
                style="@style/TextAppearance.ApexDrive.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvBtStatusBadge"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnLaunchCarPlay"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ad_target"
                android:background="@drawable/ad_bg_btn_primary"
                android:textColor="@color/ad_on_accent"
                android:textAllCaps="false"
                android:text="Open CarPlay" />

            <!-- Retired labels still addressed by the connection code. -->
            <TextView
                android:id="@+id/tvCarPlayReadyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCarPlayProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
