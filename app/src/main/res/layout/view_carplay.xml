<?xml version="1.0" encoding="utf-8"?>
<!-- Phone: connection status and the two actions that matter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/ad_shell_inset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/ad_tile_padding"
        android:background="@drawable/bg_panel">

        <TextView
            style="@style/TextAppearance.ApexDrive.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone" />

        <TextView
            android:id="@+id/tvConnectDevice"
            style="@style/TextAppearance.ApexDrive.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No phone connected" />

        <TextView
            android:id="@+id/tvConnectStatus"
            style="@style/TextAppearance.ApexDrive.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose a phone to connect" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_target"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLaunchCarPlayFull"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ad_bg_btn_primary"
                android:textColor="@color/ad_on_accent"
                android:textAllCaps="false"
                android:text="Open CarPlay" />

            <Button
                android:id="@+id/btnChoosePhone"
                style="@style/TextAppearance.ApexDrive.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/ad_target_gap"
                android:background="@drawable/ad_bg_btn_secondary"
                android:textAllCaps="false"
                android:text="Choose phone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
