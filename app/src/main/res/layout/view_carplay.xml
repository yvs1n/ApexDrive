<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Banner Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_panel"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPLE CARPLAY CONTROLLER"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ZLINK 5.3 HARDWARE PROJECTION · HYUNDAI SANTA FE"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLaunchCarPlayFull"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/bg_elevated_btn"
            android:text="LAUNCH FULLSCREEN PROJECTION"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:paddingStart="26dp"
            android:paddingEnd="26dp" />

    </LinearLayout>

    <!-- Info Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 · WIRELESS PROJECTION"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Connects over Bluetooth (SantafemR) and tunnels through a 5GHz Wi-Fi bridge for latency-free touch response."
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTOCOL: ZLINK 5.3 ACTIVE"
                android:textColor="@color/status_active"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02 · WIRED USB LINK"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Direct USB OTG link via Santa Fe center console or glove box port. Delivers high-bitrate audio and device charging."
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORT STATUS: USB 2.0 READY"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03 · DSP AUDIO TUNNEL"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Audio stream decoded via internal Rohm/SI473X ICs with hardware equalizer presets."
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUDIO STREAM: I2S HARDWARE SYNC"
                android:textColor="@color/status_active"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
