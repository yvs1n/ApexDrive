<?xml version="1.0" encoding="utf-8"?>
<!-- Settings group item: selected = surface-3 fill (segment-selected is white on the Day card). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="@dimen/ad_radius_control" /><solid android:color="@color/ad_fill_pressed" /></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><corners android:radius="@dimen/ad_radius_control" /><solid android:color="@color/ad_surface_3" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="@dimen/ad_radius_control" /><solid android:color="@android:color/transparent" /></shape></item>
</selector>
