<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_fill_pressed" />
            <corners android:radius="@dimen/ad_radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ad_surface_3" />
                    <corners android:radius="@dimen/ad_radius_control" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="@color/ad_accent" />
                    <corners android:radius="@dimen/ad_radius_control" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_surface_3" />
            <corners android:radius="@dimen/ad_radius_control" />
        </shape>
    </item>
</selector>
