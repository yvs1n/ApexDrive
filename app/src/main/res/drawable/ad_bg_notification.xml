<?xml version="1.0" encoding="utf-8"?>
<!-- Notification capsule. Uses the solid glass colour until GlassDrawable is wired in. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="@color/ad_glass_solid" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <stroke android:width="1dp" android:color="@color/ad_glass_edge" />
        </shape>
    </item>
</layer-list>
