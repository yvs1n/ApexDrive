<?xml version="1.0" encoding="utf-8"?>
<!-- Floating glass panel (rail): solid glass fallback, 1 dp edge and top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><corners android:radius="@dimen/ad_radius_tile" /><solid android:color="@color/ad_glass_solid" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="@dimen/ad_radius_tile" /><stroke android:width="1dp" android:color="@color/ad_glass_edge" /></shape></item>
</layer-list>
